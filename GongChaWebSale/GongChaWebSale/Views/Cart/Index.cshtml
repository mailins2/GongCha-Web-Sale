@model List<GongChaWebSale.Models.giohang_sanpham>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutPageUser.cshtml";
}
<style>
    #successMessage {
        position: absolute;
        top: 0;
        right: 0;
        z-index: 2;
        width: 250px;
        border-radius: 10px;
    }

        #successMessage button {
            position: absolute;
            top: 0;
            right: 0;
            z-index: 3;
        }

        #successMessage p {
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
</style>
@if (TempData["Message"] != null)
{
    <div class="alert alert-success" id="successMessage">
        <button onclick="closeMessage()" class="btn btn-small btn-warning"><i class='bx bx-x'></i></button>
        <p style="margin: 0;">@TempData["Message"]</p>
    </div>



}
<div class="content p-3">
    <h5>Giỏ hàng của bạn</h5>
    <div class="order-card bg-white shadow-sm rounded p-3 mb-3 my-5">

        @if (ViewBag.gh.Count == 0)
        {
            <table class="table table-hover">
                <tr>
                    <td>
                        <strong>Đơn hàng :  </strong>
                    </td>
                    <td>
                        <p class="mb-0 text-muted ">Trạng thái :  </p>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <p style="display:flex;justify-content:center;padding:50px"> Không có dữ liệu</p>
                    </td>
                </tr>
            </table>

        }
        else
        {
            <table class="table">
                @foreach (var tmp in ViewBag.gh)
                {
                    <tr>
                        <td colspan="7">
                            <strong>Đơn hàng : @tmp.MaGH</strong>
                        </td>

                    </tr>
                    <tr>
                        <th>
                            Sản phẩm
                        </th>
                        <th>Tên</th>
                        <th>Size</th>
                        <th>Topping</th>
                        <th>Số lượng</th>
                        <th>Tổng tiền</th>
                        <th style="display:flex;justify-content:center">Edit</th>

                    </tr>
                    foreach (var item in Model)
                    {

                        if (item.MaGH == tmp.MaGH)
                        {
                            <tr>

                                <td>
                                    <img src="@Url.Content(item.SanPham.Hinh)" width="100px" />
                                </td>
                                <td>
                                    @item.SanPham.TenSP
                                </td>
                                <td>
                                    @item.Size
                                </td>
                                <td>
                                    <img src="@Url.Content(item.Topping.Hinh)" width="100px" />
                                </td>
                                <td>
                                    @item.SoLuong
                                </td>
                                <td>@item.TongTienSP.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))đ</td>
                                <td>
                                    <form action="/Cart/Delete" method="post" style="display:flex">
                                        <input type="hidden" value="@item.MaGH" name="MaGH" />
                                        <input type="hidden" value="@item.MaSP" name="MaSP" />
                                        <input type="hidden" value="@item.Size" name="Size" />
                                        <input type="hidden" value="@item.MaTP" name="MaTP" />
                                        <button type="submit" class="btn btn-outline-warning">Xóa</button>
                                    </form>
                                    <form action="/Cart/Edit" method="post" style="display:flex">
                                        <input type="hidden" value="@item.MaGH" name="MaGH" />
                                        <input type="hidden" value="@item.MaSP" name="MaSP" />
                                        <input type="hidden" value="@item.Size" name="Size" />
                                        <input type="hidden" value="@item.MaTP" name="MaTP" />

                                        <button type="submit" class="btn btn-outline-warning">Sửa</button>
                                    </form>

                                </td>

                            </tr>

                        }

                    }
                    <tr>
                        <td colspan="7">
                            <p style=" display:flex;justify-content:end"> Thanh toán : @tmp.TongTien.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))đ</p>
                        </td>
                    </tr>



                }

            </table>
        }
        <div style="display: flex; justify-content: end;margin-right:50px;">
            <button href="/Users/DanhGia" class="btn btn-danger btn-sm my-5" style="padding: 8px 15px">Mua ngay</button>
        </div>





    </div>





</div>

<script type="text/javascript">
    function closeMessage() {
        var message = document.getElementById("successMessage");
        message.style.display = "none";
    }
</script>