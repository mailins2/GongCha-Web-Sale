@{
    Layout = null;
}

﻿
<!DOCTYPE html>

<html style="margin: 0;padding:0">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <style>
        input:focus {
            outline: none !important;
            box-shadow: none;
        }
        #hover1:hover{
            opacity: 70%;
            cursor:pointer;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-xl navbar-light" style="background-color: #187b25; margin:0;padding:0">
        <div class="container-fluid">
            <a class="navbar-brand" href="#"><img style="width:70px; height:80px" src="~/Images/logo.png" /></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-flex justify-content-between" id="navbarSupportedContent">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="#" style="font-size: 20px; font-weight: bold; margin: 0 20px; color: #d6df7e ">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" style="font-size: 20px; font-weight: bold; margin: 0 20px; color: #d6df7e">Giới thiệu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" style="font-size: 20px; font-weight: bold; margin: 0 20px; color: #d6df7e">Khuyến mãi</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Product/Index" style="font-size: 20px; font-weight: bold; margin: 0 20px; color: #d6df7e">Thực đơn</a>
                    </li>
                </ul>
                <div style="width:500px; height: 40px;margin-left: 10px; border-radius: 38px; border:none; position:relative; background-color: white">
                    <form class="d-flex">
                        <input style="width:400px; height: 40px;margin-left: 10px; border-radius: 38px; border:none;" type="search" placeholder="Tìm kiếm " aria-label="Search">
                        <button style="position:absolute; background-color:transparent; right:10px;height:40px;border:none" type="submit"><i style="color: #187b25 " class="fa-solid fa-magnifying-glass fa-lg"></i></button>
                    </form>
                </div>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <i style="margin: 0 20px; color: #d6df7e; cursor:pointer" class="fa-solid fa-user fa-2xl" style="color: #ffffff;"></i>
                    </li>
                    <li class="nav-item">
                        <i style="margin: 0 30px; color: #d6df7e; cursor: pointer" class="fa-solid fa-bag-shopping fa-2xl" style="color: #ffffff;"></i>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div>
        @RenderBody()
    </div>
    <footer>
        <div class="container-fluid" style="background-color: #faa49a;">
            <div class="d-flex align-items-center justify-content-center" style="padding:20px;">
                <div style="display: flex;flex-direction:column; padding:20px">
                    <img style="width:70px; height:80px;margin:auto" src="~/Images/logo.png" />
                    <p style="font-weight: bold;padding: 10px 0">ĐĂNG KÝ NHẬN THÔNG TIN KHUYẾN MÃI</p>
                    <form class="d-flex">
                        <input type="text" placeholder="Nhập email của bạn " style="width: 300px; height: 40px; border-radius: 10px; border: none;padding-left:10px" />
                        <button type="submit" style="width: 90px; height: 40px; padding: 10px; border: none; border-radius: 10px; background-color: #c4391d;color:white;flex-wrap:nowrap;font-weight:bold;display:flex;align-items:center;justify-content:center">Gửi ngay</button>
                    </form>
                </div>
                <div style="display: flex; flex-direction: column; padding: 20px">
                    <b>Thông tin </b>
                    <a href="#" style="text-decoration:none;color: black">Tin tức</a>
                    <a href="#" style="text-decoration:none;color: black">Khuyến mãi </a>
                    <a href="#" style="text-decoration:none;color: black">Tuyển dụng</a>
                    <a href="#" style="text-decoration:none;color: black">Nhượng quyền</a>
                </div>
                <div style="width: 20%; display: flex; flex-direction: column; padding: 20px">
                    <b>Hỗ trợ</b>
                    <a href="#" style="text-decoration:none;color: black">Điều khoản sử dụng</a>
                    <a href="#" style="text-decoration:none;color: black">Chính sách bảo mật</a>
                    <a href="#" style="text-decoration:none;color: black">Chính sách giao hàng</a>
                    <a href="#" style="text-decoration:none;color: black">Chăm sóc khách hàng </a>
                </div>
                <div style="display: flex; flex-direction: column; padding: 20px;align-items:start">
                    <b>Theo dõi</b>
                    <a href="#" style="text-decoration:none;color: black"><img style="width: 50px;height:30px" src="~/Images/fblogo.png" />Facebook</a>
                    <a href="#" style="text-decoration:none;color: black"><img style="width: 50px;height:25px" src="~/Images/insta-logo.png" />Instagram</a>
                    <a href="#" style="text-decoration:none;color: black"><img style="width: 25px;height:25px;margin:10px" src="~/Images/zalo-logo.png" />Zalo</a>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
</body>
</html>
