@model List<GongChaWebSale.Models.banggia>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet" />
<div style="display:flex; justify-content: center;">
    <div class=" list-menu">

        @*menu*@
        <hr style="border-top: 3px solid #000000; width: 1200px;" />
        <div style=" display: grid;
                     grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
                     justify-content: center;
                     width: 100%;
                     margin: 0 auto;">
            <div style="width: 50%; text-align: center; margin: 0;">
                <i class="fa-solid fa-glass-water" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Trasua" style="text-decoration: none; color: #090808;">Trà sữa</a></span>
            </div>
            <div style="width: 50%; text-align: center; margin: 0;">
                <i class="fa-solid fa-glass-water" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Okinawa" style="text-decoration: none; color: #090808;">Okinawa</a></span>
            </div>
            <div style="width: 50%; text-align: center; margin: 0;">
                <i class="fa-solid fa-glass-water" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Tratraicay" style="text-decoration: none; color: #090808;">Trà trái cây</a></span>
            </div>
            <div style="width: 60%; text-align: center; margin: 0;">
                <i class="fa-solid fa-glass-water" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Tranguyenchat" style="text-decoration: none; color: #090808;">Trà nguyên chất</a></span>
            </div>
            <div style="width: 70%; text-align: center; margin: 0;">
                <i class="fa-solid fa-glass-water" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Thucuongsangtao" style="text-decoration: none; color: #090808;">Thức uống sáng tạo</a></span>
            </div>
            <div style="width: 30%; text-align: center; margin-left: 14px; margin-top: 10px;">
                <i class="fa-solid fa-ice-cream" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Kem" style="text-decoration: none; color: #090808;">Kem</a></span>
            </div>
            <div style="width: 40%; text-align: center; margin-left: 10px; margin-top: 10px;">
                <i class="fa-solid fa-bowl-rice" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Topping" style="text-decoration: none; color: #090808;">Topping</a></span>
            </div>
            <div style="width: 70%; text-align: center; margin-left: 1px; margin-top: 10px;">
                <i class="fa-solid fa-glass-water" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Thucuongdaxay" style="text-decoration: none; color: #090808;">Thức uống đá xay</a></span>
            </div>
            <div style="width: 100%; text-align: center; margin-left: 2px; margin-top: 10px;">
                <i class="fa-solid fa-glass-water" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Thucuongdacbiet" style="text-decoration: none; color: #090808;">Thức uống đặc biệt Gong Cha</a></span>
            </div>
        </div>
        <hr style="border-top: 1px solid #000000; width: 1200px;" />

        @*product*@
        <div class="product">
            <div style="border: none; text-align: center; width: 1200px; padding: 10px;
                        background-color: #D6DF7E; font-size: large; font-weight: 500;">TẤT CẢ</div>
            <form action="/Product/Index" style="margin-left: 10px; margin-top: 20px">
            </form>
            <div class="row row-cols-1 row-cols-md-3 g-4 " style=" width: 1200px; margin: 10px 0px 20px 0px;">
                @foreach (var item in Model)
                {
                    bool flag = false;
                    foreach (var km in ViewBag.Khuyenmai)
                    {
                        if (item.MaSP == km.MaSP)
                        {
                            flag = true;
                            <div class="col">
                                <div class="card" style="height: 600px;">
                                    <a href="/Product/Details/@item.MaSP">
                                        <div style="border-radius: 100%; padding: 10px; background-color: #FAA49A; width: 45px; height: 45px; display: flex; justify-content: center; align-content: center; position: absolute; top: 10px; right: 10px ">
                                            <p style="font-weight: bold; color: #C4391D ">@((km.Ptgiam * 100).ToString("0"))%</p>
                                        </div>
                                        <img src="@Url.Content(item.SanPham.Hinh)" class="card-img-top" alt="...">
                                        <div class="card-body ">
                                            <div>
                                                <h5 class="card-title"><a href="/Product/Details/@item.MaSP" style="text-decoration: none; color: #187b25;">@item.SanPham.TenSP</a></h5>
                                                <p style="color:gray" class="card-text text-truncate overflow-hidden">@item.SanPham.MoTa</p>
                                                <p class="card-text" style="color: #C4391D;font-weight:bold">@(((item.DonGia)-(item.DonGia * km.Ptgiam)).ToString("N0", new System.Globalization.CultureInfo("vi-VN")))đ</p>
                                                <p class="card-text" style="text-decoration:line-through;color:grey">@item.DonGia.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))đ</p>
                                            </div>
                                            <button type="button" class="btn btn-outline-danger " style="font-weight:500; width: 295px; margin-top: 10px; ">Mua ngay</button>
                                            <button type="button" class="btn btn-danger float-end" style="padding: 10px; margin-top: 10px;">
                                                <a href="#" style="text-decoration: none;">
                                                    <i class="fa-solid fa-cart-shopping" style="color: #e4e2e4;"></i>
                                                </a>
                                            </button>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        }


                    }
                    if (!flag)
                    {
                        <div class="col">
                            <div class="card" style="height: 600px;">
                                <a href="/Product/Details/@item.MaSP">
                                    <img src="@Url.Content(item.SanPham.Hinh)" class="card-img-top" alt="...">
                                    <div class="card-body ">
                                        <div>
                                            <h5 class="card-title"><a href="/Product/Details/@item.MaSP" style="text-decoration: none; color: #187b25;">@item.SanPham.TenSP</a></h5>
                                            <p style="color:gray" class="card-text text-truncate overflow-hidden">@item.SanPham.MoTa</p>
                                            <p class="card-text" style="color: #C4391D;font-weight:bold">@item.DonGia.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))đ</p>
                                        </div>

                                        <button type="button" class="btn btn-outline-danger " style="font-weight:500; width: 295px; margin-top: 50px; ">Mua ngay</button>
                                        <button type="button" class="btn btn-danger float-end" style="padding: 10px; margin-top: 50px;">
                                            <a href="#" style="text-decoration: none;">
                                                <i class="fa-solid fa-cart-shopping" style="color: #e4e2e4;"></i>
                                            </a>
                                        </button>
                                    </div>
                                </a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        <nav aria-label="..." style=" color: dimgrey">
            <ul class="pagination" style="justify-content:center;">
                @if (ViewBag.Page > 1)
                {
                    <li class="page-item ">
                        <a class="page-link" style=" color: #e4e2e4; " href="/Product/Index?page=@(ViewBag.Page-1)">&laquo;</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link btn" style="color: #e4e2e4;">&laquo;</span>
                    </li>
                }

                @for (int i = 1; i <= @ViewBag.TotalPage; i++)
                {
                    if (i == @ViewBag.Page)
                    {
                        <li class="page-item  @(i==@ViewBag.Page ? "active" : "")">
                            <a class=" page-link" style=" color: #e4e2e4;" href="/Product/Index?page=@i">
                                @i
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item ">
                            <a class=" page-link" style=" color: #e4e2e4;" href="/Product/Index?page=@i">
                                @i
                            </a>
                        </li>

                    }
                }

                @if (ViewBag.Page < ViewBag.TotalPage)
                {
                    <li class="page-item ">
                        <a class="page-link" style=" color: #e4e2e4;" href="/Product/Index?page=@(ViewBag.Page + 1)">&raquo;</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <a class="page-link" style=" color: #e4e2e4;" href="#">&raquo;</a>
                    </li>
                }

            </ul>
        </nav>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>



