
@model List<GongChaWebSale.Models.banggia>
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}


<div style="display:flex; justify-content: center;">
    <div class=" list-menu">

        @*menu*@
        <hr style="border-top: 3px solid #000000; width: 1200px;" />
        <div style=" display: grid;
                     grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
                     justify-content: center;
                     width: 100%;
                     margin: 0 auto;">
            <div style="width: 50%; text-align: center; margin: 0;">
                <i class="fa-solid fa-glass-water" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Trasua" style="text-decoration: none; color: #090808;">Trà sữa</a></span>
            </div>
            <div style="width: 50%; text-align: center; margin: 0;">
                <i class="fa-solid fa-glass-water" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Okinawa" style="text-decoration: none; color: #090808;">Okinawa</a></span>
            </div>
            <div style="width: 50%; text-align: center; margin: 0;">
                <i class="fa-solid fa-glass-water" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Tratraicay" style="text-decoration: none; color: #090808;">Trà trái cây</a></span>
            </div>
            <div style="width: 60%; text-align: center; margin: 0;">
                <i class="fa-solid fa-glass-water" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Tranguyenchat" style="text-decoration: none; color: #090808;">Trà nguyên chất</a></span>
            </div>
            <div style="width: 70%; text-align: center; margin: 0;">
                <i class="fa-solid fa-glass-water" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Thucuongsangtao" style="text-decoration: none; color: #090808;">Thức uống sáng tạo</a></span>
            </div>
            <div style="width: 30%; text-align: center; margin-left: 14px; margin-top: 10px;">
                <i class="fa-solid fa-ice-cream" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Kem" style="text-decoration: none; color: #090808;">Kem</a></span>
            </div>
            <div style="width: 40%; text-align: center; margin-left: 10px; margin-top: 10px;">
                <i class="fa-solid fa-bowl-rice" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Topping" style="text-decoration: none; color: #090808;">Topping</a></span>
            </div>
            <div style="width: 70%; text-align: center; margin-left: 1px; margin-top: 10px;">
                <i class="fa-solid fa-glass-water" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Thucuongdaxay" style="text-decoration: none; color: #090808;">Thức uống đá xay</a></span>
            </div>
            <div style="width: 100%; text-align: center; margin-left: 2px; margin-top: 10px;">
                <i class="fa-solid fa-glass-water" aria-hidden="true" style="color: #cf2d2d"></i>
                <span style="margin-left: 3px; font-weight: bold;"><a href="/Thucuongdacbiet" style="text-decoration: none; color: #090808;">Thức uống đặc biệt Gong Cha</a></span>
            </div>
        </div>
        <hr style="border-top: 1px solid #000000; width: 1200px;" />

        @*trinh bay san pham*@
        @foreach (var item in Model)
        {
            bool flag = false;
            foreach (var km in ViewBag.Khuyenmai)
            {

                if (item.MaSP == km.MaSP && item.Size == "M" && flag == false)// nhung sp co 2 size va co khuyen mai
                {
                    flag = true;
                    <span><a href="/Product/Index" style="text-decoration: none; float: left; font-weight: 500; color: #C4391D; ">Thực đơn ></a></span>
                    <span style="font-weight: 500; color: #187b25; float: left; ">@Model.Select(row => row.SanPham.TenSP).FirstOrDefault()</span>
                    <div style="float: left; margin-top: 30px; margin-bottom: 60px; margin-left: -130px;">
                        <img src="@Url.Content(Model.Select(row => row.SanPham.Hinh).FirstOrDefault()) " style="width: 450px; " />
                    </div>
                    <div style="float: right; margin-top: 60px; margin-bottom: 60px; width: 50%;">
                        <h3 style="color: #187b25; margin-right: 330px;">@Model.Select(row => row.SanPham.TenSP).FirstOrDefault()</h3>
                        <p style="color: gray; max-width: 480px;">@Model.Select(row => row.SanPham.MoTa).FirstOrDefault()</p>
                        <h5 style="color: #C4391D; font-weight: bold; " id="priceDisplay">@(((item.DonGia)-(item.DonGia * km.Ptgiam)).ToString("N0", new System.Globalization.CultureInfo("vi-VN")))đ</h5>
                        <p class="card-text" style="text-decoration:line-through;color:grey">@item.DonGia.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))đ</p>
                        <div style="margin-top: 20px;">
                            <button onclick="decrease()" style="width: 40px; border: none; background-color: #187b25; color: aliceblue; height: 30px; border-radius: 2px; ">-</button>
                            <input type="text" id="quantity" value="0" readonly style="width: 50px; text-align: center; margin-left: -3px; border: none; height: 30px;">
                            <button onclick="increase()" style="width: 40px; border: none; background-color: #187b25; color: aliceblue; height: 30px; border-radius: 2px; ">+</button>
                        </div>
                        <div style=" width: 100%;  display: flex; margin-top: 30px;">
                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#staticBackdrop" style="font-weight:500; width: 50%; height: 50px;">
                                Mua ngay
                            </button>
                            <button type="button" data-bs-toggle="modal" data-bs-target="#staticBackdrop" class="btn btn-danger float-end" style=" margin-left:5px; width: 10%; height: 50px; ">
                                <a href="#" style="text-decoration: none;">
                                    <i class="fa-solid fa-cart-shopping" style="color: #e4e2e4;"></i>
                                </a>
                            </button>
                        </div>
                    </div>
                }
            }
            if (item.Size == "M" && flag == false)// nhung sp co 2 size va co khuyen mai
            {
                flag = true;
                <span><a href="/Product/Index" style="text-decoration: none; float: left; font-weight: 500; color: #C4391D; ">Thực đơn ></a></span>
                <span style="font-weight: 500; color: #187b25; float: left; ">@Model.Select(row => row.SanPham.TenSP).FirstOrDefault()</span>
                <div style="float: left; margin-top: 30px; margin-bottom: 60px; margin-left: -130px;">
                    <img src="@Url.Content(Model.Select(row => row.SanPham.Hinh).FirstOrDefault()) " style="width: 450px; " />
                </div>
                <div style="float: right; margin-top: 60px; margin-bottom: 60px; width: 50%;">
                    <h3 style="color: #187b25; margin-right: 330px;">@Model.Select(row => row.SanPham.TenSP).FirstOrDefault()</h3>
                    <p style="color: gray; max-width: 480px;">@Model.Select(row => row.SanPham.MoTa).FirstOrDefault()</p>
                    <h5 style="color: #C4391D; font-weight: bold; " id="priceDisplay">@item.DonGia.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))đ</h5>

                    <div style="margin-top: 20px;">
                        <button onclick="decrease()" style="width: 40px; border: none; background-color: #187b25; color: aliceblue; height: 30px; border-radius: 2px; ">-</button>
                        <input type="text" id="quantity" value="0" readonly style="width: 50px; text-align: center; margin-left: -3px; border: none; height: 30px;">
                        <button onclick="increase()" style="width: 40px; border: none; background-color: #187b25; color: aliceblue; height: 30px; border-radius: 2px; ">+</button>
                    </div>
                    <div style=" width: 100%;  display: flex; margin-top: 30px;">
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#staticBackdrop" style="font-weight:500; width: 50%; height: 50px;">
                            Mua ngay
                        </button>
                        <button type="button" data-bs-toggle="modal" data-bs-target="#staticBackdrop" class="btn btn-danger float-end" style=" margin-left:5px; width: 10%; height: 50px; ">
                            <a href="#" style="text-decoration: none;">
                                <i class="fa-solid fa-cart-shopping" style="color: #e4e2e4;"></i>
                            </a>
                        </button>
                    </div>
                </div>
            }
        }

        <!-- Modal -->
        <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="staticBackdropLabel" style="color: #C4391D">Chọn món mới</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @*<div style=" padding-top:5px; padding-bottom: 5px;padding-left: 10px; font-weight: 600;border: none; background-color: #dddddd; height: 30px; color:gray;">Chọn Size </div>*@
                        <table class="table">

                            <tr style=" padding-top:5px; padding-bottom: 5px;padding-left: 10px; font-weight: 600;border: none; background-color: #dddddd; height: 30px; color:gray;">
                                <td colspan="2" style="border: none;">Chọn Size</td>
                            </tr>
                            <tr>
                                @foreach (var item in Model)
                                {
                                    bool flag = false;
                                    foreach (var km in ViewBag.Khuyenmai)
                                    {
                                        if ((item.MaSP == km.MaSP && item.Size == "M") || (item.MaSP == km.MaSP && item.Size == "L"))
                                        {
                                            flag = true;
                                        <tr>
                                            <td>
                                                <h5 style="font-size: 18px;">@item.Size </h5>
                                                <p>@(((item.DonGia) - (item.DonGia * km.Ptgiam)).ToString("N0", new System.Globalization.CultureInfo("vi-VN")))đ</p>
                                            </td>
                                            <td>
                                                <div>
                                                    <input class="form-check-input" type="checkbox" id="checkboxNoLabel" value="" aria-label="...">
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                if (!flag)
                                {
                                    <tr>
                                        <td>
                                            <h5 style="font-size: 18px;">@item.Size </h5>
                                            <p>@item.DonGia.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))đ</p>
                                        </td>
                                        <td>
                                            <div>
                                                <input class="form-check-input" type="checkbox" id="checkboxNoLabel" value="" aria-label="...">
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                                </tr>
                                <tr style=" padding-top:5px; padding-bottom: 5px;padding-left: 10px; font-weight: 600;border: none; background-color: #dddddd; height: 30px; color:gray;">
                                    <td colspan="2" style="border:none;">Chọn Topping</td>
                                </tr>
                                @foreach (var tp in ViewBag.Topping)
                                {
                                    <tr>
                                        <td>
                                            <h5 style="font-size: 18px;">@tp.TenTP</h5>
                                            <p style="font-size: 15px;">@tp.DonGia.ToString("N0", new System.Globalization.CultureInfo("vi-VN"))đ</p>
                                        </td>
                                        <td>
                                            <div>
                                                <input class="form-check-input" type="checkbox" id="checkboxNoLabel" value="" aria-label="...">
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </table>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Mua ngay</button>
                                <button type="button" class="btn btn-outline-danger" style=" height: 38px;">
                                    <a href="#" style="text-decoration: none;">
                                        <i class="fa-solid fa-cart-shopping" style="color: #e4e2e4;"></i>
                                    </a>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
    function increase() {
        let quantityInput = document.getElementById('quantity');
        let currentQuantity = parseInt(quantityInput.value);
        quantityInput.value = currentQuantity + 1;
    }
    function decrease() {
        let quantityInput = document.getElementById('quantity');
        let currentQuantity = parseInt(quantityInput.value);
        if (currentQuantity > 0) {
            quantityInput.value = currentQuantity - 1;
        }
    }
    </script>