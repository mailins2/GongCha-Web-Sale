@model GongChaWebSale.Models.taikhoan
@{
    ViewBag.Title = "ManageAccount";
    Layout = "~/Views/Shared/_LayoutPageUser.cshtml";
}
<style>
    #successMessage {
        position: absolute;
        top: 0;
        right: 0;
        z-index: 2;
        width: 250px;
        border-radius: 10px;
    }

    #successMessage button {
        position: absolute;
        top: 0;
        right: 0;
        z-index: 3;
    }

    #successMessage p {
        padding: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

    <div class="content p-3">
        <h5>Thông tin tài khoản </h5>

        <div class="order-card bg-white shadow-sm rounded p-3 mb-3 my-5">
            <form action="/User/ManageAccount" method="post" style="width:60%;margin:20px auto">
                <div class="mb-3">
                    <label for="tentk" class="form-label">tên tài khoản</label>
                    <input type="text" class="form-control" id="tentk" name="TenTK" value="@Model.TenTK">

                </div>

                <div class="mb-3">
                    <label for="ns" class="form-label">Ngày sinh</label>
                    <input type="date" class="form-control" id="ns" name="NgaySinh" value="@Model.NgaySinh">

                </div>
                <div class="mb-3">
                    <label class="form-label" for="PassWord">Mật khẩu của bạn</label>
                    <input class="form-control" type="password" placeholder="Mật khẩu của bạn * " id="PassWord" name="MatKhau" value="@Model.MatKhau" />
                    <div id="passwordHelpBlock" class="form-text" style="width:80%">
                        Your password must be 6-20 characters long, contain letters and numbers, and must not contain spaces, special characters, or emoji.
                    </div>
                </div>
                <div class="form-group mb-3">

                    <label for="gender">Giới tính</label>
                    <div style="display: flex; ">
                        @if (Model.GioiTinh == "Nam")
                        {
                            <div class="form-check" style="margin-right:10px">
                                <input class="form-check-input" type="radio" name="GioiTinh" id="male" value="Nam" checked>
                                <label class="form-check-label" for="male">Nam</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="GioiTinh" id="female" value="Nữ">
                                <label class="form-check-label" for="female">Nữ</label>
                            </div>
                        }

                        else
                        {
                            <div class="form-check" style="margin-right:10px">
                                <input class="form-check-input" type="radio" name="GioiTinh" id="male" value="Nam">
                                <label class="form-check-label" for="male">Nam</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="GioiTinh" id="female" value="Nữ" checked />
                                <label class="form-check-label" for="female">Nữ</label>
                            </div>
                        }
                    </div>

                </div>
                <div class="mb-3">
                    <label for="dc" class="form-label">Địa chỉ</label>
                    <input type="text" class="form-control" id="dc" name="DiaChi" value="@Model.DiaChi" required>

                </div>

                <div class="mb-3">
                    <label class="form-label" for="Email">
                        Email của bạn
                    </label>
                    <input class="form-control" type="email" placeholder="Email của bạn * " id="Email" name="Email" value="@Model.Email" required />
                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                </div>
                <div class="mb-3">
                    <label class="form-label" for="PhoneNumber">Số điện thoại </label>
                    <input class="form-control" type="tel" placeholder="Số điện thoại của bạn * " id="SDT" name="SDT" value="@Model.SDT" required />
                    @Html.ValidationMessageFor(model => model.SDT, "", new { @class = "text-danger" })

                </div>
                <button type="submit" class="btn btn-outline-primary" style="width:100px;">Submit</button>
            </form>
        </div>

    </div>

    <script type="text/javascript">
        function closeMessage() {
            var message = document.getElementById("successMessage");
            message.style.display = "none";
        }
    </script>
