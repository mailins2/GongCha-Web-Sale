@model List<GongChaWebSale.Models.chitietdonhang>
@{
    ViewBag.Title = "HistoryPD";
    Layout = "~/Views/Shared/_LayoutPageUser.cshtml";
}

<div class="content p-3">
    <h5>Lịch sử mua hàng </h5>
    
        @foreach (var item in ViewBag.tt)
        {
            <a href="/User/HistoryPD/@item.MaTrangThai" class="btn btn-outline-primary btn-sm ">@item.TenTrangThai</a>
        }
        


</div>

<div class="order-card bg-white shadow-sm rounded p-3 mb-3 my-5">
    <table class="table ">
        @if (ViewBag.dh.Count==0)
        {
            <tr>
                <td>
                    <strong>Đơn hàng :  </strong>
                </td>
                <td>
                    <p class="mb-0 text-muted ">Trạng thái :  </p>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <p style="display:flex;justify-content:center;padding:50px"> Không có dữ liệu</p>
                </td>
            </tr>
        }
        @foreach (var tmp in ViewBag.dh)
        {
            <tr>
                <td>
                    <strong>Đơn hàng : @tmp.MaDH</strong>
                </td>
                <td colspan="5">
                    <p class="mb-0 text-muted ">Trạng thái : @tmp.TrangThaiDonHang.TenTrangThai </p>
                </td>
            </tr>
            foreach (var item in Model)
            {
                if (item.MaDH == tmp.MaDH)
                {
                    <tr>

                        <td>
                            <img src="@item.SanPham.Hinh" width="100px" />
                        </td>
                        <td>
                            @item.SanPham.TenSP
                        </td>
                        <td>
                            @item.Size
                        </td>
                        <td>
                            <img src="@item.Topping.Hinh" width="100px" />
                        </td>
                        <td>
                            @item.SoLuong
                        </td>
                        <td>@item.TongTienSP</td>
                    </tr>
                }


            }
        }
    </table>

    <div class="order-item d-flex align-items-center my-5  " style="margin:20px auto;justify-content:end">
        <a href="/Users/DanhGia" class="btn btn-outline-warning btn-sm mx-2">Đánh giá</a>
        <a href="" class="btn btn-outline-secondary btn-sm mx-2">Liên hệ người bán </a>
        <a href="" class="btn btn-outline-primary btn-sm mx-2">Mua lại</a>
    </div>
</div>

