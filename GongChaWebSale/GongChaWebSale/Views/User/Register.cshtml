
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_LayoutPage.cshtml";
}

<div>
    <div class="row">
        <div class="col-6 mb-5 mt-5">
            <img src="~/Images/poster.jpg" width="95%" style="margin-left:10px" class="object-fit-cover border rounded" alt="Error">
        </div>
        <form class="col-6 mb-5 mt-5" action="/User/Register">

            <table class=" d-flex justify-content-end" style="margin-left:10px;border-collapse:separate;border-spacing:20px;">
                <tr>
                    <th>
                        TẠO TÀI KHOẢN
                    </th>
                </tr>
                <tr>
                    <td>
                        <label class="form-label" for="LastName">Họ của bạn</label>
                        <input class="form-control" type="text" placeholder="Họ của bạn" id="LastName" name="LastName" style="width: 80%; border: none; outline: none; border-radius: 0px; border-bottom: 1px solid black" />
                    </td>
                </tr>
                <tr>

                    <td>
                        <label class="form-label" for="FirstName">Tên của bạn</label>
                        <input class="form-control" type="text" placeholder="Tên của bạn * " id="FirstName" name="FirstName" style="width: 80%; border: none; outline: none; border-radius: 0px; border-bottom: 1px solid black" />
                    </td>

                </tr>
                <tr>
                    <td>
                        <label class="form-label" for="PhoneNumber">Số điện thoại </label>
                        <input class="form-control" type="tel" placeholder="Số điện thoại của bạn * " id="PhoneNumber" name="PhoneNumber" style="width:80%;border:none;outline:none;border-radius:0px;border-bottom:1px solid black" />
                    </td>
                </tr>
                <tr>
                    <td>
                        <label class="form-label" for="Email">
                            Email của bạn
                        </label>
                        <input class="form-control" type="email" placeholder="Email của bạn * " id="Email" name="Email" style="width: 80%; border: none; outline: none; border-radius: 0px; border-bottom: 1px solid black" />

                    </td>
                </tr>
                <tr>
                    <td>
                        <label class="form-label" for="PassWord">Mật khẩu của bạn</label>
                        <input class="form-control" type="password" placeholder="Mật khẩu của bạn * " id="PassWord" name="PassWord" aria-describedby="passwordHelpBlock" style="width: 80%; border: none; outline: none; border-radius: 0px; border-bottom: 1px solid black" />
                        <div id="passwordHelpBlock" class="form-text" style="width:80%">
                            Your password must be 8-20 characters long, contain letters and numbers, and must not contain spaces, special characters, or emoji.
                        </div>
                    </td>
                </tr>





            </table>
            <div class="justify-content-center d-flex" style="width:80%;">
                <button type="submit" class="btn  mt-2 mb-2" style="width: 300px; background-color: #C4391D">
                    <span style="color:#fce7e7"> Đăng ký</span>
                </button>
            </div>
        </form>
    </div>
</div>

